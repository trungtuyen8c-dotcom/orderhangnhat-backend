DATABASE_URL=postgresql://orderhn:change_me_pg@localhost:5432/orderhn?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me_to_a_long_random_secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
PORT=4000
NODE_ENV=development
ADMIN_EMAIL=admin@orderhn.local
ADMIN_PASSWORD=Admin@12345
# Danh sach origin duoc goi API (phan cach dau phay). Rong = dev cho moi origin, prod chi same-origin
CORS_ORIGINS=
# Cookie refresh chi qua HTTPS. Mac dinh true khi NODE_ENV=production; dat false neu site con HTTP
COOKIE_SECURE=false
# Tat worker hang doi trong process API (backup/sheet sync se khong chay neu khong co worker rieng)
WORKERS_ENABLED=true
LOG_LEVEL=info

DATABASE_URL=postgresql://orderhn:change_me_pg@localhost:5432/orderhn?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me_to_a_long_random_secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
PORT=4000
NODE_ENV=development
ADMIN_EMAIL=admin@orderhn.local
ADMIN_PASSWORD=Admin@12345
# Danh sach origin duoc goi API (phan cach dau phay). Rong = dev cho moi origin, prod chi same-origin
CORS_ORIGINS=
# Cookie refresh chi qua HTTPS. Mac dinh true khi NODE_ENV=production; dat false neu site con HTTP
COOKIE_SECURE=false
# false = process API khong chay worker hang doi + cron (backup/sheet sync/thong bao/canh bao).
# Khi do PHAI chay them process worker: npm run start:worker (node dist/worker.js, bo qua bien nay)
WORKERS_ENABLED=true
# Lich backup tu dong (cu phap cron, gio Asia/Ho_Chi_Minh). Mac dinh 02:00 hang ngay; de rong de tat
BACKUP_CRON=0 2 * * *
LOG_LEVEL=info
# 2FA (TOTP): khoa AES-256-GCM ma hoa secret authenticator (32 byte: openssl rand -base64 32).
# Production BAT BUOC khi co user bat 2FA (thieu/sai -> 2FA tra loi 503, khong bao gio luu plaintext).
# Doi/mat khoa = moi user da bat 2FA khong dang nhap duoc (admin phai Reset 2FA). Dev de rong -> khoa suy ra tu JWT_SECRET.
TOTP_ENC_KEY=
# Ten hien trong app authenticator (Google Authenticator, Authy...)
TOTP_ISSUER=Order Hang Nhat
# Vai tro bat buoc bat 2FA (phan cach dau phay, vd super_admin,accountant). Rong = 2FA tuy chon cho moi user
REQUIRE_2FA_ROLES=
